# =============================================================================
# University MIS - Environment Variables Template
# Copy to .env and fill in real values. NEVER commit the actual .env file.
# =============================================================================

# --- Database ---
DB_NAME=university_mis
DB_USER=mis_admin
DB_PASSWORD=changeme-use-a-strong-password
DB_HOST=postgres
DB_PORT=5432

# --- Redis ---
REDIS_PASSWORD=changeme-use-a-strong-password
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT Auth ---
JWT_SECRET=changeme-generate-a-random-64-char-string
JWT_REFRESH_SECRET=changeme-generate-a-different-random-64-char-string
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# --- AWS / S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=university-mis-storage

# --- App ---
NODE_ENV=development
PORT=5000
REACT_APP_API_BASE_URL=http://localhost:5000/api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Docker Hub (used by docker-compose.prod.yml / CD pipeline) ---
DOCKERHUB_USERNAME=
IMAGE_TAG=latest

# --- Traefik (docker-compose.prod.yml only) ---
ACME_EMAIL=ops@university.edu
