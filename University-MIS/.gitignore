# =============================================================================
# University MIS - Root .gitignore
# =============================================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
frontend/build/
backend/dist/
coverage/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
kubernetes/secret.yaml.local

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/tfplan
terraform/.terraform.lock.hcl

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Backups (local scratch space used by scripts/backup.sh, restore.sh)
/tmp/mis-backups/
/tmp/mis-restore/
